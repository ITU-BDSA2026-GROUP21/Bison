@page "/obs"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>

    <h3>
        <a href="/PostObservation">Post observation</a>
    </h3>


    <form method="get">
        <partial name="_TaxonDropdown" model="@(new Bison.Razor.Pages.TaxonDropdown
                 {
                     TaxonDropdownOptions = Model.TaxonDropdownOptions,
                     SelectedDwcTaxonId = Model.SelectedDwcTaxonId,
                     Name = "dwcTaxonId",
                     AutoSubmit = true
                 })" />

        <noscript>
            <button type="submit">Filter</button>
        </noscript>
    </form>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Username">@obs.Username</a>
                        </strong>
                        <a href="/ob/@obs.Id">@obs.Text</a>
                        @if (obs.TaxonVernacularName != null)
                        {
                            <small>&mdash; @obs.TaxonVernacularName</small>
                        }
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }

    <nav>
        @if (Model.CurrentPage > 1)
        {
            <a href="/obs?page=@(Model.CurrentPage - 1)&dwcTaxonId=@Model.SelectedDwcTaxonId">Previous Page</a>
        }
        @if (Model.Observations.Count == PagingDefaults.PageSize)
        {
            <a href="/obs?page=@(Model.CurrentPage + 1)&dwcTaxonId=@Model.SelectedDwcTaxonId">Next Page</a>
        }
    </nav>
</div>
