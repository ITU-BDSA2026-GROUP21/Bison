@page "/ob/{id:int}"
@using Microsoft.AspNetCore.Identity;
@model Bison.Razor.Pages.ObservationModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var obs = Model.Observation!;
    var mostUpvoted = Model.MostUpvoted!;
}

<div>
    <h1> @obs.Username's observation </h1>
    <div style="display: flex;">
        <div style="flex: 80%;">
            <ul id="observation" class="observations">
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Username">@obs.Username</a>
                        </strong>
                        @obs.Text
                        @if (obs.TaxonVernacularName != null)
                        {
                            <small>&mdash; @obs.TaxonVernacularName</small>
                        }
                        <small>&mdash; @obs.Timestamp</small>
                    </p>

                    <!--This is for showing the optional photo for an observation.-->
                    @if (!string.IsNullOrEmpty(obs.PicturePath))
                    {
                        <img class="observation-photo" src="@($"/photos/{obs.PicturePath}")"
                             alt="Photo for this observation." />
                    }
                    @if (!string.IsNullOrEmpty(obs.License))
                    {
                        <p>
                            <small>Photo by @obs.Username, licensed under: ©
                                <a href="https://creativecommons.org/licenses/@obs.License/4.0/" target="_blank">CC
                                    @obs.License
                                    4.0</a>
                                </small>
            
                            </p>
                        }
                    </li>
                </ul>
            </div>
            @if (User.Identity.IsAuthenticated)
            {
                <div style="flex: 20%;">
                    <form method="post" asp-page-handler="UpvoteObservation" asp-route-id="@obs.Id">

                        <button type="submit" style="font-weight: @(Model.HasUpvoted[obs.Id] ? "bold" : "normal")">
                            Upvote
                        </button>

                    </form>
                </div>
            }
        </div>
        <h2> Comments </h2>
        @if (User.Identity.IsAuthenticated)
        {
            <form class="commentbox" method="post" asp-page-handler="PostComment">
                <label style="margin-bottom: 8px; display: block;" asp-for="Input.CommentText">Leave a comment:</label>
                <input style="float: left;" type="text" asp-for="Input.CommentText" />
                <input type="submit" value="Share">
            </form>
        }
        <ul id="commentlist" class="observations">
            @foreach (var com in Model.Comments)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@com.Username">@com.Username</a>
                        </strong>
                        @com.Text
                        <small>&mdash; @com.Timestamp</small>
                    </p>
                </li>
            }
        </ul>

        <br />

        <h2> Proposals </h2>
        @if (User.Identity.IsAuthenticated)
        {
            <form class="proposalBox" method="post" asp-page-handler="PostProposal">
                <label style="margin-bottom: 8px; display: block;" asp-for="Input.ProposalText">Make a proposal:</label>
                <input style="margin-bottom: 8px; display: block;" type="text" asp-for="Input.ProposalText" />

                <label style="margin-bottom: 8px; display: block;" asp-for="Input.TaxonId">Proposed taxon:</label>
                <partial name="_TaxonDropdown" asp-for="Input.TaxonId" model="@(new Bison.Razor.Pages.TaxonDropdown
                         {
                             TaxonDropdownOptions = Model.TaxonDropdownOptions,
                             SelectedDwcTaxonId = Model.SelectedDwcTaxonId,
                             Name = "Input.TaxonId",
                             AutoSubmit = false
                         })" />

                <input type="submit" value="Share">
            </form>
        }
        <ul id="proposalList" class="observations">
            @foreach (var pro in Model.Proposals)
            {
                <div style="display: flex;">
                    <div style="flex: 80%;">
                        <li>
                            <p>
                                <strong>
                                    <a href="/obs/@pro.Username">@pro.Username</a>
                                </strong>
                                @pro.Text
                                <small>@pro.TaxonName</small>
                                <small>&mdash; @pro.Timestamp</small>
                            </p>
                        </li>
                    </div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div style="flex: 20%;">
                            <form method="post" asp-page-handler="UpvoteProposal" asp-route-id="@obs.Id"
                                  asp-route-proposalId="@pro.Id">

                                <button type="submit" style="font-weight: @(Model.HasUpvoted[pro.Id] ? "bold" : "normal")">
                                    Upvote
                                </button>

                            </form>
                        </div>
                    }
                </div>
            }
        </ul>

        <br />

        @if (mostUpvoted != null)
        {
            <h2> Community consensus </h2>
            <ul id="consensusTaxon" class="observations">
                <li>
                    This bird has been voted to be a:
                    <strong>
                        @mostUpvoted.TaxonName
                    </strong>
                    <br />
                    First suggested by:
                    <strong>
                        <a href="/obs/@mostUpvoted.Username">@mostUpvoted.Username</a>
                    </strong>
                    <small>&mdash; @obs.Timestamp</small>
                </li>
            </ul>
        }
    </div>