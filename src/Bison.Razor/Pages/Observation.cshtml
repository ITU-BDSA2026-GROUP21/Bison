@page "/ob/{id:int}"
@model Bison.Razor.Pages.ObservationModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var obs = Model.Observation!;
}

<div>
    <h1> @obs.Username's observation </h1>
    <ul id="observation" class="observations">
        <li>
            <p>
                <strong>
                    <a href="/obs/@obs.Username">@obs.Username</a>
                </strong>
                @obs.Text
                <small>&mdash; @obs.Timestamp</small>
            </p>
        </li>
    </ul>

    <h2> Comments </h2>
    <ul id="commentlist" class="observations">
        @foreach (var com in Model.Comments)
        {
            <li>
                <p>
                    <strong>
                        <a href="/obs/@com.Username">@com.Username</a>
                    </strong>
                    @com.Text
                    <small>&mdash; @com.Timestamp</small>
                </p>
            </li>
        }
    </ul>

    <h2> Proposals </h2>
    <ul id="proposalList" class="observations">
        @foreach (var pro in Model.Proposals)
        {
            <li>
                <p>
                    <strong>
                        <a href="/obs/@pro.Username">@pro.Username</a>
                    </strong>
                    @pro.Text
                    <small>@pro.TaxonName</small>
                    <small>&mdash; @pro.Timestamp</small>
                </p>
            </li>
        }
    </ul>

</div>