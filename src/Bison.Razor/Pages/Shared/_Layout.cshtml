<!DOCTYPE html>
<html lang="en">

<head>
    <title>@ViewData["Title"]</title>
    <link href="/css/style.css" rel="stylesheet" type="text/css" />
    <link rel="icon" type="image/png" href="/favicon/favicon.ico">
</head>

<body>
    <div class=page>
        <h1><img src="/images/icon1.png" alt="Icon1" />Bison</h1>

        <div class=navigation>
            @if (User.Identity.IsAuthenticated)
            {
                <div>
                    <a class="nav-link text-dark" href="/@(User.Identity.Name)">My Observations</a> |
                    <a class="nav-link text-dark" href="/">Public Observations</a> |
                    <a class="nav-link text-dark" ...>Logout [@(User.Identity.Name)]</a>
                </div>
            }
            else
            {
                <div>
                    <a class="nav-link text-dark" href="/">Public Observations</a> |
                    <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
                    <a class="nav-link text-dark" ...>Login</a>
                </div>
            }
        </div>

        <div class=body>
            @RenderBody()
        </div>
        <div class=footer>
            Bison &mdash; An ASP.NET Application
        </div>
    </div>


</body>
@await RenderSectionAsync("Scripts", required: false)

</html>
